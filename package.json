    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
