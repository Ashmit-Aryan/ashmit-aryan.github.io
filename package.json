    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-scroll": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "zod": "^4.6.5"
